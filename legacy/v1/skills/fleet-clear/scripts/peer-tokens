#!/usr/bin/env python3
# peer-tokens: print "<peer> <tokens>" for each peer named, where tokens is the size of the context the peer re-reads on
# its next turn (input + cache read + cache creation of its last API call), read from the newest Claude Code session log of
# the peer's working folder. -1 when no log or no usage is found. Touches nothing (read-only).
# Usage: peer-tokens <peer>=<cwd> ...      (fleet-clear passes each peer with its pane's current folder)
# FLEET_CLAUDE_PROJECTS overrides ~/.claude/projects (tests).
import glob, json, os, re, sys

projects = os.environ.get("FLEET_CLAUDE_PROJECTS", os.path.expanduser("~/.claude/projects"))
for arg in sys.argv[1:]:
    peer, _, cwd = arg.partition("=")
    # Claude Code names a project folder after its path with every non-alphanumeric character turned into "-"
    folder = os.path.join(projects, re.sub(r"[^A-Za-z0-9]", "-", cwd))
    logs = sorted(glob.glob(os.path.join(folder, "*.jsonl")), key=os.path.getmtime)
    usage = None
    if logs:
        with open(logs[-1], errors="replace") as f:
            for line in f:
                try:
                    message = json.loads(line).get("message")
                except ValueError:
                    continue
                if isinstance(message, dict) and message.get("usage"):
                    usage = message["usage"]
    if usage is None:
        print(peer, -1)
    else:
        print(peer, sum(usage.get(k, 0) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")))
