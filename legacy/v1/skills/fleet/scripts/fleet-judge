#!/usr/bin/env bash
# fleet-judge: one typed judgment for fleet-dispatch, from the first backend that answers with enough confidence.
#   fleet-judge <question> [file]   the text to judge comes from <file>, else stdin
# Prints "<answer> <confidence>" (confidence 0..1) and exits 0; exits 2 when no backend answers confidently (the caller
# escalates), 1 on a usage error. Touches nothing; the claude backend makes a model call, the cmd backend runs FLEET_JUDGE_CMD.
# Questions (name: allowed answers):
#   route        architect | owner | pr-architect | security-architect | user   who answers a peer's question
#   brief-ready  yes | no   is a board card complete enough to build from without asking anyone
# Backends, tried in FLEET_JUDGE order (environment > profile > default "rules,claude"):
#   rules   keyword rules; answers only when one matches (confidence 1), else passes
#   cmd     FLEET_JUDGE_CMD "<question>" "<answers, space-separated>" with the text on stdin; it prints "<answer> <confidence>".
#           The hook for a typed-verdict model such as Jev: point it at a small wrapper around that model's API.
#   claude  claude -p on FLEET_JUDGE_MODEL (default haiku), asked twice; the same answer twice counts as 0.9, else it passes
# A backend that fails (missing CLI, timeout, bad output) passes to the next. FLEET_JUDGE_MIN (default 0.8) is the lowest
# confidence accepted; below it the next backend is tried.
set -uo pipefail
source "$(dirname "$0")/lib/profile.sh"
fleet_load_profile || exit 1
q=${1:-}; [ $# -le 2 ] && [ -n "$q" ] || { echo "usage: fleet-judge <route|brief-ready> [file]" >&2; exit 1; }
case "$q" in
  route) answers="architect owner pr-architect security-architect user"
    ask="A peer in a team of AI coding agents ended its turn with the question below. Who should answer it? architect: design, \
contracts, schemas, architecture, root cause. owner: the engineer who owns the work (implementation detail, tests, CI). \
pr-architect: review, approval, merging. security-architect: auth, tokens, secrets, permissions, exposure. user: product scope, \
priorities, money, accounts, anything only the human who owns the product can decide." ;;
  brief-ready) answers="yes no"
    ask="Below is a work card from a team board. Can an engineer build it without asking anyone: is the goal clear, are there \
testable acceptance criteria, and is it clear which part of the code it touches? Answer yes or no." ;;
  *) echo "fleet-judge: unknown question '$q' (route, brief-ready)" >&2; exit 1 ;;
esac
text=$(cat "${2:-/dev/stdin}")
MIN=${FLEET_JUDGE_MIN:-0.8}
allowed() { [[ " $answers " == *" $1 "* ]]; }
# ok <answer> <confidence>: true when the answer is allowed and the confidence is a number at or above MIN
ok() { allowed "$1" && awk -v c="$2" -v m="$MIN" 'BEGIN { exit !(c ~ /^[0-9.]+$/ && c + 0 >= m + 0) }'; }
# limit <seconds> <command…>: run it, killed after that many seconds (macOS has no timeout(1); perl's alarm keeps stdin)
limit() { perl -e 'alarm shift; exec @ARGV' "$@"; }

rules() {
  local t; t=$(tr '[:upper:]' '[:lower:]' <<<"$text")
  case "$q" in
    route)
      if grep -qE 'merge|approve|review' <<<"$t"; then echo pr-architect
      elif grep -qE 'token|secret|auth[a-z]*|permission|credential|exposure' <<<"$t"; then echo security-architect
      elif grep -qE 'design|schema|contract|architect|migration|interface' <<<"$t"; then echo architect
      elif grep -qE 'pric|budget|scope|priorit|customer|launch' <<<"$t"; then echo user
      fi ;;
    brief-ready)  # fleet-dispatch puts "acceptance criteria: <n>" on the first line of a card's text
      if grep -qiE '^acceptance criteria: 0$' <<<"$text"; then echo no
      elif grep -qiE '^acceptance criteria: [1-9]' <<<"$text" && [ ${#text} -ge 400 ]; then echo yes
      fi ;;
  esac
}

cmd() {
  [ -n "${FLEET_JUDGE_CMD:-}" ] || return 1
  limit "${FLEET_JUDGE_TIMEOUT:-10}" "$FLEET_JUDGE_CMD" "$q" "$answers" <<<"$text" 2>/dev/null | head -1
}

claude_once() {
  local schema prompt
  schema=$(jq -nc --arg a "$answers" '{type: "object", properties: {answer: {type: "string", enum: ($a | split(" "))}},
    required: ["answer"], additionalProperties: false}')
  prompt="$ask Reply with one of: $answers.

---
$text"
  limit "${FLEET_JUDGE_TIMEOUT:-60}" claude -p --model "${FLEET_JUDGE_MODEL:-haiku}" --no-session-persistence \
    --output-format json --json-schema "$schema" --tools "" <<<"$prompt" 2>/dev/null \
    | jq -r '.structured_output.answer // empty' 2>/dev/null
}
claude_backend() {
  command -v claude >/dev/null || return 1
  local d a b; d=$(mktemp -d)
  claude_once > "$d/a" & claude_once > "$d/b" & wait   # the two asks run side by side
  a=$(cat "$d/a"); b=$(cat "$d/b"); rm -rf "$d"
  [ -n "$a" ] && [ "$a" = "$b" ] && echo "$a 0.9"
}

IFS=, read -ra backends <<<"${FLEET_JUDGE:-rules,claude}"
for be in "${backends[@]}"; do
  case "$be" in
    rules) out=$(rules); [ -z "$out" ] || out="$out 1" ;;
    cmd) out=$(cmd) ;;
    claude) out=$(claude_backend) ;;
    *) echo "fleet-judge: unknown backend '$be' in FLEET_JUDGE" >&2; continue ;;
  esac
  read -r ans conf <<<"${out:-}"
  if [ -n "${ans:-}" ] && ok "$ans" "${conf:-0}"; then echo "$ans $conf"; exit 0; fi
done
exit 2
