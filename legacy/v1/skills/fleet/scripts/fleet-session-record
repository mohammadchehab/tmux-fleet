#!/usr/bin/env bash
# fleet-session-record: a fleet peer's Claude Code SessionStart and Stop hook (hooks/peer-settings.json, passed by
# fleet-up as --settings). Records the peer's current claude session id into its roster file
# ($FLEET_STATE/roster.d/<peer>), so `fleet up` can `claude --resume <id>` it after a restart or reboot.
#
# SessionStart fires on startup, /clear and resume, and Stop fires at every turn end, so the roster always holds the
# LIVE session id — never a pre-/clear one (a /clear mints a new id, and its SessionStart overwrites the roster).
#
# Plain bash reading the hook's one-line JSON from stdin and extracting session_id with sed. The hook's JSON is a
# single line ({"session_id":"…","transcript_path":"…",…}); this is the safe shape — the bash+heredoc-into-python form
# that fed python a program on stdin was SIGKILLed by endpoint security (see fleet-reply-log). Never blocks the peer:
# every failure exits 0 silently.
set -u
source "$(dirname "$0")/lib/roster.sh"
st="${FLEET_STATE:-}"
[ -n "$st" ] && [ -d "$st" ] || exit 0
peer="${TERM_SESSION_ID:-}"          # fleet-up sets it to the peer's session name, fleet[-<profile>]-<peer>
case "$peer" in fleet-*) ;; *) exit 0 ;; esac   # only the fleet's own sessions have a roster
profile="${FLEET_PROFILE:-}"
for prefix in "fleet-$profile-" "fleet-"; do
  case "$peer" in "$prefix"*) peer=${peer#"$prefix"}; break ;; esac
done
[ -n "$peer" ] || exit 0
sid=$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
[ -n "$sid" ] || exit 0
roster_set_id "$st" "$peer" "$sid"
exit 0
