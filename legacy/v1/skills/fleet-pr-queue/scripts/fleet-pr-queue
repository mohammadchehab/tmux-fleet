#!/usr/bin/env bash
# fleet-pr-queue — sort every open PR into the bucket that says who acts next.
#   READY    CI green, not draft, not held          → pr-architect merges
#   RED      a check failed                         → the author's engineer fixes
#   NO-CI    no checks ran (stale / conflict)       → engineer rebases and pushes
#   STACKED  base is another branch, not main       → waits for its base PR
#   DRAFT    draft                                  → author finishes it
#   CHANGES  review requested changes               → author addresses them
# Usage: fleet-pr-queue [repo-dir]   (default: FLEET_REPO, the profile's repo, or the main checkout of the repo you are in)
set -u
source "$(dirname "$0")/../../fleet/scripts/lib/profile.sh"
REPO=${1:-}
[ -n "$REPO" ] || fleet_resolve_repo || exit 1
cd "$REPO" || exit 1

gh pr list --state open --limit 100 \
  --json number,title,headRefName,baseRefName,isDraft,reviewDecision,statusCheckRollup,updatedAt \
  --jq '
  def checks: [.statusCheckRollup[]? | (.conclusion // .state)];
  .[] |
  (checks) as $c |
  (if .isDraft then "DRAFT"
   elif .reviewDecision == "CHANGES_REQUESTED" then "CHANGES"
   elif ($c | any(. == "FAILURE" or . == "ERROR" or . == "TIMED_OUT" or . == "CANCELLED")) then "RED"
   elif ($c | length) == 0 then "NO-CI"
   elif ($c | any(. == "PENDING" or . == "IN_PROGRESS" or . == "QUEUED" or . == "EXPECTED")) then "RUNNING"
   elif .baseRefName != "main" then "STACKED"
   else "READY" end) as $b |
  "\($b)\t#\(.number)\t\(.updatedAt[0:16])\t\(.headRefName)\t\(if .baseRefName != "main" then "on " + .baseRefName + " · " else "" end)\(.title[0:80])"' \
| sort -t$'\t' -k1,1 -k2,2 \
| awk -F'\t' '
  $1 != last { if (NR > 1) print ""; print "== " $1 " =="; last = $1 }
  { printf "  %-6s %s  %-38s %s\n", $2, $3, $4, $5; n[$1]++ }
  END { print ""; printf "Totals:"; for (b in n) printf " %s=%d", b, n[b]; print "" }'
