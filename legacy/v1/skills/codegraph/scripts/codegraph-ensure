#!/usr/bin/env bash
# codegraph-ensure: make CodeGraph usable in a repo. Installs the codegraph CLI (npm -g) when it is missing, then indexes the
# repo's main checkout (codegraph init -y) when it has no .codegraph/ yet, and excludes .codegraph/ locally (.git/info/exclude,
# never the repo's .gitignore) so it never shows as untracked. Run from a worktree, it indexes the main checkout: worktrees under
# <repo>/.claude/worktrees find that index by walking up. Idempotent: says ok and exits when both are in place.
# Touches: the global npm packages (install only), <main checkout>/.codegraph/, <git common dir>/info/exclude.
# Usage: codegraph-ensure [path]   (default: the current directory)
set -euo pipefail
PKG=@colbymchenry/codegraph
dir=$(cd "${1:-.}" && pwd)

if command -v codegraph >/dev/null 2>&1; then echo "ok      codegraph $(codegraph --version 2>/dev/null)"
else
  command -v npm >/dev/null 2>&1 || { echo "codegraph-ensure: no npm; install node first" >&2; exit 1; }
  echo "installing $PKG"; npm i -g "$PKG" >/dev/null
  command -v codegraph >/dev/null 2>&1 || { echo "codegraph-ensure: installed $PKG but codegraph is not on PATH ($(npm prefix -g)/bin)" >&2; exit 1; }
  echo "installed codegraph $(codegraph --version 2>/dev/null)"
fi

# the main checkout, so every worktree shares one index; outside git, the folder itself
root=$dir
if common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  root=$(dirname "$common")
  ex="$common/info/exclude"; mkdir -p "$(dirname "$ex")"
  grep -qx '/.codegraph/' "$ex" 2>/dev/null || echo '/.codegraph/' >> "$ex"
fi
if [ -d "$root/.codegraph" ]; then echo "ok      $root/.codegraph"
else echo "indexing $root"; codegraph init -y "$root"; fi
