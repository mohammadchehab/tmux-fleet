# Template for a fleet profile. COPY IT, do not edit it in place, and do not commit a real profile to this repo:
#   mkdir -p ~/.config/fleet/profiles && cp profiles/example.env ~/.config/fleet/profiles/<name>.env
# Then start with FLEET_PROFILE=<name> (for example `FLEET_PROFILE=<name> fleet-up`). A profile is looked up in
# ~/.config/fleet/profiles/<name>.env first, then in this folder. Real profiles live per user, outside the repo.
#
# A profile holds only values the fleet scripts read. Facts about the project itself (tracker, board, lines of business,
# paths) live in the target repo's AGENTS.md and are never copied here; `task lint` fails if they are.
# Precedence: environment variable > profile > the script's own default.
# Format: FLEET_KEY=value, one per line. `~` and `$HOME` are expanded. No other syntax is read, nothing is executed.
# A trailing `# lint: allow <reason>` accepts a value the profile lint flags as repeating the target repo's AGENTS.md.

# The repo the fleet works on (the checkout the peers' worktrees come from).
FLEET_REPO=~/Dev/<repo>
# Squad that `fleet-up` starts with no arguments (a file in skills/fleet/squads/).
FLEET_SQUAD=squad  # lint: allow names a fleet squad file, not a project fact
# Your name: who the peers work for ("the user" in the roles). Empty: git user.name in FLEET_REPO.
FLEET_USER=
# Optional: a tracker the target repo's AGENTS.md must not name (a personal or temporary board). Wins over AGENTS.md
# (rule 9 of the fleet skill). FLEET_TRACKER_PROJECT=none: no ticket keys and no Jira calls. Empty: AGENTS.md's tracker.
FLEET_TRACKER_SITE=
FLEET_TRACKER_PROJECT=
# Optional: peers that work in their own clone instead of a worktree of FLEET_REPO, as peer=folder, space-separated
# (for example the squad `teams`). Empty: every peer gets a worktree of FLEET_REPO.
FLEET_PEER_DIRS=
# Optional: the board's port, so its URL (http://127.0.0.1:<port>) is stable and can be bookmarked. Empty: a port derived from
# the profile name (6420 with no profile), so two profiles never clash.
FLEET_BOARD_PORT=
# Optional: the target repo's spec and architecture files or folders the fleet-board skill copies onto the board, relative to
# FLEET_REPO, space-separated. Empty: every tracked ARCHITECTURE*/SPEC* file and .md under a folder named architecture, arch,
# spec(s), adr(s), decisions or design.
FLEET_BOARD_DOCS=
# Optional: days without a commit or file change after which `fleet wt` calls a topic worktree idle. Empty: 7.
FLEET_WT_IDLE_DAYS=
