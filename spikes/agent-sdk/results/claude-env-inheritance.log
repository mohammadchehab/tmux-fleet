# Reproduction: a session the fleet asked to run as `claude` came up on DeepInfra instead.
#
# The probe passed options.env = { ...process.env }. options.env REPLACES the child environment, so the
# parent shell's inherited ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_MODEL reached the CLI and
# won. Nothing in the message stream flags this as wrong: the turn succeeded, cost was recorded, and only the
# model id says what happened. Catching it needs §4's rule — compare model() against the SessionSpec after
# start — which is why the harness now builds the child env from scratch (see childEnv() in probe.mjs).
#
# raw probe output follows:

init.model = deepseek-ai/DeepSeek-V4.1-Flash-1017 | apiKeySource = none
modelUsage keys = [ 'deepseek-ai/DeepSeek-V4.1-Flash-1017' ]
