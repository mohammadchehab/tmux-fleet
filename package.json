{
  "name": "tmux-fleet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The fleet's TypeScript packages (architecture §1.1, §15). The shell half of the repo has no node dependencies.",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "fleet": "node apps/clients/cli/src/main.ts",
    "fleet-board": "node apps/clients/board/src/main.ts",
    "fleet-view": "node apps/clients/view/src/main.ts",
    "test": "node --test 'packages/**/test/**/*.test.ts' 'apps/**/test/**/*.test.ts' 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp@^5": "6.2.6",
      "glob@^13": "14.0.4",
      "minimatch@^10": "11.0.5"
    }
  }
}
