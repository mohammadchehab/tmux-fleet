#!/usr/bin/env bash
# fleet: the fleet's one command, from any directory. A thin dispatcher: each subcommand runs the fleet script or Taskfile task
# that does the work, in the checkout this file lives in (task install links it into ~/.local/bin; FLEET_CHECKOUT overrides it).
#   fleet [--profile <name>] <command> [args …]      --profile sets FLEET_PROFILE for this call (anywhere before a "--")
# Locks live in the scripts (skills/fleet/scripts/lib/lock.sh), so a direct script call and this command are equally safe.
set -euo pipefail
self=$0
while [ -L "$self" ]; do l=$(readlink "$self"); case "$l" in /*) self=$l ;; *) self=$(dirname "$self")/$l ;; esac; done
FLEET_CHECKOUT=${FLEET_CHECKOUT:-$(cd "$(dirname "$self")/.." && pwd -P)}
F=$FLEET_CHECKOUT/skills/fleet/scripts
SK=$FLEET_CHECKOUT/skills

usage() { cat <<USAGE
fleet [--profile <name>] <command> [args]      (checkout: $FLEET_CHECKOUT)

Run the fleet
  up [squad | peer …]        start the fleet (fleet-up)               down          stop it; worktrees and board files stay
  ls                         every fleet: view, board, peers + state  attach [peer] open the view, or one peer's session
  board [--no-open]          open the board (starts it if needed)     view          rebuild the tiled view
  scale add|remove|roles …   add or remove one peer                   clear [-n] [peer …]  clear idle peers over the token limit
  send [-f|-i] "text" [peer …]  type into peers' prompts             peek [-n N] [peer …] each peer's last reply
  capacity [lines]           who is busy, idle, asking; the board     handoff [peer] hand a peer over to a fresh copy
  prs                        the open PRs by bucket
Worktrees (fleet wt = fleet worktree), across every repo the fleet touches
  wt ls [--stale] [--json] [--no-fetch]   fetches, then each worktree: owner, branch, PR, age, dirty, unpushed, size, peer in it, class
  wt prune [--idle] [--nested] [--yes]   remove merged, gone, orphaned ones (dry run without --yes); never dirty or in use
  wt new <peer> <repo-path> <branch>     a topic worktree (. = the target repo)      wt summary   one line per profile
The board
  jira < issues.json         Jira issues onto the board               docs [path …] the repo's specs/architecture onto it
  decision ask|answer|list|show …   the user's decisions
This checkout
  install [claude|cursor|backlog|bin]   update   uninstall   lint   test   clean [--force [--sessions]]
  profile init <name> <repo> [squad]    completion bash|zsh   help
USAGE
}
# --profile <name> / --profile=<name>, anywhere before "--"; everything else is passed on as it is
args=(); seen_dd=0
while [ $# -gt 0 ]; do
  if [ $seen_dd = 0 ]; then
    case "$1" in
      --profile) [ $# -ge 2 ] || { echo "fleet: --profile needs a name" >&2; exit 2; }; export FLEET_PROFILE=$2; shift 2; continue ;;
      --profile=*) export FLEET_PROFILE=${1#--profile=}; shift; continue ;;
      --) seen_dd=1 ;;
    esac
  fi
  args+=("$1"); shift
done
set -- ${args[@]+"${args[@]}"}
cmd=${1:-help}; [ $# -eq 0 ] || shift
task_run() { exec task -t "$FLEET_CHECKOUT/Taskfile.yaml" "$@"; }

case "$cmd" in
  up)        exec "$F/fleet-up" "$@" ;;
  down)      exec "$F/fleet-down" "$@" ;;
  ls)        exec "$F/fleet-ls" "$@" ;;
  attach)    exec "$F/fleet-attach" "$@" ;;
  board)     exec "$F/fleet-board" "$@" ;;
  view)      exec "$F/fleet-view" "$@" ;;
  send)      exec "$F/fleet-send" "$@" ;;
  peek)      exec "$F/fleet-peek" "$@" ;;
  worktree|wt) exec "$F/fleet-worktree" "$@" ;;
  scale)     exec "$SK/fleet-scale/scripts/fleet-scale" "$@" ;;
  clear)     exec "$SK/fleet-clear/scripts/fleet-clear" "$@" ;;
  capacity)  exec "$SK/fleet-capacity/scripts/fleet-capacity" "$@" ;;
  handoff)   exec "$SK/fleet-handoff/scripts/fleet-handoff" "$@" ;;
  prs)       exec "$SK/fleet-pr-queue/scripts/fleet-pr-queue" "$@" ;;
  jira)      exec "$SK/fleet-board/scripts/board-jira" "$@" ;;
  docs)      exec "$SK/fleet-board/scripts/board-docs" "$@" ;;
  decision)  exec "$SK/fleet-board/scripts/board-decision" "$@" ;;
  install)   case "${1:-}" in "") task_run install ;; claude|cursor|backlog|bin) task_run "install:$1" ;;
               *) echo "fleet install: claude, cursor, backlog or bin, not '$1'" >&2; exit 2 ;; esac ;;
  update|uninstall|lint|test) task_run "$cmd" ;;
  clean)     task_run clean -- "$@" ;;
  profile)   [ "${1:-}" = init ] && [ $# -ge 3 ] || { echo "usage: fleet profile init <name> <repo> [squad]" >&2; exit 2; }
             exec "$FLEET_CHECKOUT/dev-tasks/scripts/profile/init.sh" "$2" "$3" ${4:+"$4"} ;;
  completion) exec "$FLEET_CHECKOUT/dev-tasks/scripts/install/completion.sh" "${1:-}" ;;
  _list)     # for the completion: commands, profiles, squads, roles or peers (of FLEET_PROFILE's fleet)
             case "${1:-}" in
               commands) echo "up down ls attach board view scale clear send peek capacity handoff prs wt worktree jira docs decision install update uninstall lint test clean profile completion help" ;;
               profiles) for d in "${FLEET_USER_PROFILES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/fleet/profiles}" "$FLEET_CHECKOUT/profiles"; do
                           for f in "$d"/*.env; do [ -e "$f" ] && basename "$f" .env; done; done | grep -vx example | sort -u ;;
               squads)   ls "$SK/fleet/squads" ;;
               roles)    ls "$SK/fleet/roles" | sed 's/\.md$//' ;;
               peers)    bash -c 'source "$1/lib/tmux.sh"; fleet_peers | sort' _ "$F" ;;
             esac ;;
  help|-h|--help) usage ;;
  *)         echo "fleet: no such command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
