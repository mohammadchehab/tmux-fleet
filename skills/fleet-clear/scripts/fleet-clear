#!/usr/bin/env bash
# fleet-clear: clear every idle fleet peer whose context is over a token limit, so no peer re-reads a huge history on each
# turn. Before the clear the peer writes its state (the project-manager its handoff); after it the peer reloads its role,
# any extra commands from FLEET_CLEAR_AFTER, and its saved state. The project-manager also gets its loop back.
# Token counts come from the peers' Claude Code session logs (peer-tokens), not from the pane, so the limit works long
# before Claude Code shows any "context used" warning. Busy peers are never cleared; the next run retries them.
# Touches: types into this fleet's tmux panes (fleet-<profile>-<peer>, via fleet-send); writes nothing itself. A lock stops two runs from overlapping.
#   fleet-clear [-n] [peer ...]   -n: dry run (report only); default peers: every peer of this fleet
# Settings (environment > profile > default):
#   FLEET_CLEAR_LIMIT   tokens above which an idle peer is cleared; default 150000
#   FLEET_CLEAR_AFTER   commands sent after the role reloads, separated by ";" (for example /i-have-adhd); default none
#   FLEET_PM_LOOP       the line the project-manager gets back to restart its loop; default /keep-busy (the keep-busy skill)
#   FLEET_STATE         where peers write state and the handoff; default ~/.fleet-state/<profile> (~/.fleet-state with no profile)
set -uo pipefail
dir=$(cd -P "$(dirname "$0")" && pwd)
lib=$(cd -P "$dir/../../fleet/scripts/lib" && pwd)
source "$lib/tmux.sh"
source "$lib/pane.sh"
source "$lib/profile.sh"
source "$lib/lock.sh"
fleet_load_profile || exit 1
send="$lib/../fleet-send"
dry=0; [ "${1:-}" = -n ] && { dry=1; shift; }
LIMIT=${FLEET_CLEAR_LIMIT:-150000}
STATE=$(fleet_state_dir)
PM_LOOP=${FLEET_PM_LOOP:-/keep-busy}

if [ $dry = 0 ]; then
  fleet_lock "$STATE" clear 0 2>/dev/null || { echo "fleet-clear: already running ($STATE/locks/clear.lock)"; exit 0; }
fi

busy() { fleet_busy "$1"; }
wait_idle() { sleep 10; local _; for _ in $(seq 1 36); do busy "$1" || return 0; sleep 5; done; return 1; }
say() { "$send" "$1" "$2" >/dev/null; }

peers=("$@")
[ ${#peers[@]} -gt 0 ] || peers=($(fleet_peers))
args=()
for p in "${peers[@]}"; do args+=("$p=$(tmux display -p -t "$(fleet_peer_target "$p")" '#{pane_current_path}' 2>/dev/null)"); done
[ ${#args[@]} -gt 0 ] || { echo "fleet-clear: no $FLEET_SESSION-* sessions"; exit 0; }

cleared=0
while read -r p t; do
  [ "$t" -gt "$LIMIT" ] 2>/dev/null || continue
  if busy "$p"; then echo "$p: $t tokens, busy, next run"; continue; fi
  if [ $dry = 1 ]; then echo "$p: $t tokens, would clear"; continue; fi
  role=$(fleet_peer_role "$p")
  if [ "$role" = project-manager ]; then
    say "Your context is too large and you will be cleared. Write your handoff to $STATE/handoff.md now (in flight, who has what, open questions), then stop." "$p"
  else
    say "Your context is too large and you will be cleared. Write your current item, branch, next step and open questions to $STATE/$p-state.md now, in a few lines, then stop." "$p"
  fi
  wait_idle "$p" || { echo "$p: still busy after saving, next run"; continue; }
  say /clear "$p"
  say "/fleet $role" "$p"; wait_idle "$p" || true
  IFS=';' read -ra extra <<<"${FLEET_CLEAR_AFTER:-}"
  for c in ${extra[@]+"${extra[@]}"}; do c=${c#"${c%%[![:space:]]*}"}; [ -n "$c" ] || continue; say "$c" "$p"; wait_idle "$p" || true; done
  if [ "$role" = project-manager ]; then
    say "Read $STATE/handoff.md and $STATE/scratchpad.md and take over." "$p"; wait_idle "$p" || true
    say "$PM_LOOP" "$p"
  else
    say "Read $STATE/$p-state.md and carry on from it." "$p"
  fi
  echo "$p: $t tokens, cleared"; cleared=$((cleared+1))
done < <(python3 "$dir/peer-tokens" "${args[@]}")
echo "fleet-clear: done, $cleared cleared (limit $LIMIT tokens)"
