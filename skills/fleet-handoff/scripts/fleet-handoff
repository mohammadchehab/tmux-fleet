#!/usr/bin/env bash
# fleet-handoff: a peer hands over to a fresh copy of itself, after writing its state (see ../SKILL.md).
#   fleet-handoff [peer]   default: the peer whose tmux pane runs this (fleet-<profile>-<peer>); outside tmux, project-manager
# Precondition: the state file exists: $FLEET_STATE/handoff.md for the project-manager, $FLEET_STATE/<peer>-state.md
# for any other peer. It starts a detached waiter and returns at once; end your turn right after. Once the pane is idle the
# waiter types, one at a time and each after the pane is idle again: /clear, /fleet <role>, each FLEET_CLEAR_AFTER
# command, then "read your state file". The same lines fleet-clear sends. Log: $FLEET_STATE/handoff-<peer>.log
set -uo pipefail
dir=$(cd "$(dirname "$0")" && pwd)
lib=$(cd -P "$dir/../../fleet/scripts/lib" && pwd)
source "$lib/tmux.sh"
source "$lib/pane.sh"
source "$lib/lock.sh"
S=$(fleet_state_dir)

# idle twice in a row, 3 s apart (a turn can pause between tool calls); give up after 15 minutes
wait_idle() { local _ ok=0; for _ in $(seq 1 300); do if fleet_busy "$1"; then ok=0; else ok=$((ok + 1)); [ $ok -ge 2 ] && return 0; fi; sleep 3; done; return 1; }
say() { local s; s=$(fleet_peer_target "$1"); tmux send-keys -t "$s" -l "$2"; sleep 0.6; tmux send-keys -t "$s" Enter; echo "$(date +%T) sent: $2"; }

if [ "${1:-}" = --run ]; then   # the detached waiter
  p=$2; role=$(fleet_peer_role "$p")
  fleet_lock_adopt "$S" "handoff-$p"   # the lock the queuing call passed on; released when this waiter ends
  sleep 3
  wait_idle "$p" || { echo "$(date +%T) $p still busy after 15 minutes, handoff abandoned"; exit 1; }
  say "$p" /clear; wait_idle "$p" || true
  say "$p" "/fleet $role"; wait_idle "$p" || true
  IFS=';' read -ra extra <<<"${FLEET_CLEAR_AFTER:-}"
  for c in ${extra[@]+"${extra[@]}"}; do c=${c#"${c%%[![:space:]]*}"}; [ -n "$c" ] || continue; say "$p" "$c"; wait_idle "$p" || true; done
  if [ "$role" = project-manager ]; then say "$p" "Read $S/handoff.md and $S/scratchpad.md and take over. Restart the loop the handoff names, if any."
  else say "$p" "Read $S/$p-state.md and carry on from it."; fi
  echo "$(date +%T) $p handed off"
  exit 0
fi

p=${1:-}
if [ -z "$p" ] && [ -n "${TMUX_PANE:-}" ]; then
  p=$(command tmux -S "${TMUX%%,*}" display -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)
  [[ "$p" == "$FLEET_SESSION"-?* ]] || { echo "this pane is in tmux session '$p', not $FLEET_SESSION-<peer>: pass the peer name"; exit 1; }
  p=${p#"$FLEET_SESSION"-}
fi
p=${p:-project-manager}
role=$(fleet_peer_role "$p")
if [ "$role" = project-manager ]; then f="$S/handoff.md"; else f="$S/$p-state.md"; fi
[ -s "$f" ] || { echo "no $f: write it first (see the fleet-handoff skill)"; exit 1; }
tmux has-session -t "$(fleet_peer_target "$p")" 2>/dev/null || { echo "no tmux session $(fleet_session "$p"): ask the user to type /clear, then /fleet $role"; exit 1; }
# one handoff per peer at a time (lib/lock.sh): the waiter keeps the lock until it has typed its last line
fleet_lock "$S" "handoff-$p" 0 2>/dev/null || { echo "a handoff of $p is already queued ($S/locks/handoff-$p.lock); end your turn"; exit 0; }
nohup "$0" --run "$p" </dev/null >"$S/handoff-$p.log" 2>&1 &
fleet_lock_pass "$S" "handoff-$p" $!
echo "handoff of $p queued: once this turn ends, /clear, /fleet $role, then read $f. End your turn now. Log: $S/handoff-$p.log"
