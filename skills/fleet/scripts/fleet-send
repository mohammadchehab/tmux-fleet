#!/usr/bin/env bash
# fleet-send: type a line into fleet peers' Claude prompts (tmux sessions fleet-<profile>-<peer>,
# fleet-<peer> with no FLEET_PROFILE).
#   fleet-send [-f] "<text>" [peer ...]   default peers: every running peer of this fleet
#   fleet-send -i [peer ...]              interrupt only (Escape), send nothing
#   -f  force: a busy peer queues typed input until its turn ends, so interrupt it (Escape) first
set -uo pipefail
source "$(dirname "$0")/lib/tmux.sh"
source "$(dirname "$0")/lib/pane.sh"
force=0; interrupt_only=0
case "${1:-}" in -f) force=1; shift;; -i) interrupt_only=1; shift;; esac
text=""; [ $interrupt_only = 1 ] || { text=${1:?usage: fleet-send [-f] \"<text>\" [peer ...] | fleet-send -i [peer ...]}; shift; }
peers=("$@")
[ ${#peers[@]} -gt 0 ] || peers=($(fleet_peers))
for p in "${peers[@]}"; do
  s=$(fleet_session "$p")
  tmux has-session -t "$(fleet_target "$s")" 2>/dev/null || { echo "$p: no session $s"; continue; }
  if [ $interrupt_only = 1 ] || { [ $force = 1 ] && fleet_busy "$p"; }; then
    tmux send-keys -t "$(fleet_target "$s")" Escape; sleep 0.5; tmux send-keys -t "$(fleet_target "$s")" Escape; sleep 1
  fi
  if [ -n "$text" ]; then tmux send-keys -t "$(fleet_target "$s")" -l "$text"; sleep 0.6; tmux send-keys -t "$(fleet_target "$s")" Enter; fi
done
sleep 3
for p in "${peers[@]}"; do tmux has-session -t "$(fleet_peer_target "$p")" 2>/dev/null && { fleet_busy "$p" && echo "$p: busy" || echo "$p: idle"; }; done
