#!/usr/bin/env python3
"""fleet-reply-log: Claude Code Stop hook on every fleet peer (skills/fleet/hooks/peer-settings.json, passed by fleet-up as
--settings). When a peer's turn ends, append its reply to $FLEET_STATE/replies.log, one line:
    <utc time> <peer> [<card/PR refs>] <ASK|->: <first 400 chars of the reply, one line>
ASK marks a reply that ends with a question or says it is blocked or waiting: the project-manager answers those on its
keep-busy tick (step 2) and routes to the user only through board-decision. A pane is write-only and dies with /clear;
the log is what the PM, fleet-standup and the user read. Never blocks the peer: every failure exits 0 silently.

Deliberately a plain python file reading the hook's JSON from stdin. The first version was a bash script running
`python3 - "$json" <<heredoc`; on a Mac with endpoint security that exact shape (an interpreter fed its program on stdin,
with a long argument) was SIGKILLed on every busy peer while every other step of the hook survived. Keep it boring.
"""
import json
import os
import re
import sys
import time


def main() -> None:
    state = os.environ.get("FLEET_STATE", "")
    if not state or not os.path.isdir(state):            # not a fleet peer
        return
    peer = os.environ.get("TERM_SESSION_ID", "")           # fleet-up sets it to the peer's session name
    profile = os.environ.get("FLEET_PROFILE", "")
    for prefix in ((f"fleet-{profile}-" if profile else None), "fleet-"):
        if prefix and peer.startswith(prefix):
            peer = peer[len(prefix):]
            break
    if not peer:
        return
    try:
        hook = json.load(sys.stdin)
    except Exception:
        return
    path = hook.get("transcript_path") or ""
    if not path or not os.path.exists(path):
        return
    text = ""
    with open(path, errors="replace") as fh:
        for line in fh:
            if len(line) > 2_000_000:                      # a reply is never that big; skip tool-result monsters cheaply
                continue
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get("type") != "assistant":
                continue
            content = (o.get("message") or {}).get("content") or []
            parts = [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
            if any(p.strip() for p in parts):
                text = "\n".join(p for p in parts if p.strip())
    if not text.strip():
        return
    refs = sorted(set(re.findall(r"\b(?:TASK-\d+(?:\.\d+)?|#\d{2,5}|D\d{1,3})\b", text)))
    last = text.strip().splitlines()[-1].strip()
    ask = last.endswith("?") or bool(re.search(
        r"\b(blocked|waiting (?:on|for) (?:you|the user|a decision)|your (?:call|decision|signal))\b", text, re.I))
    flat = re.sub(r"\s+", " ", text).strip()
    if len(flat) > 400:
        flat = flat[:399] + "…"
    line = "%s %s [%s] %s: %s\n" % (time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime()), peer,
                                     ",".join(refs) if refs else "-", "ASK" if ask else "-", flat)
    with open(os.path.join(state, "replies.log"), "a") as out:
        out.write(line)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
