#!/usr/bin/env bash
# fleet-dispatch: one tick of the project-manager's loop as plain rules, so a fleet can run without a project-manager peer.
# It reads the peers' panes, the board, the target repo's PRs and the decisions, applies the rules below, and asks fleet-judge
# only where a rule needs judgment. What fleet-judge cannot answer confidently goes to the escalation log, never to a guess.
#   fleet-dispatch            dry run: log what it would do, send and change nothing
#   fleet-dispatch --live     do it
# Run it every few minutes (a crontab line, or /loop in a Claude session outside the fleet). One tick at a time (lock).
# Rules, each at most once per event (markers in $FLEET_STATE/dispatch/, dispatch-dry/ for dry runs):
#   assign    an idle peer whose role is in FLEET_DISPATCH_ROLES and holds no In Progress card gets the top card of Next:
#             first one assigned to it, else an unassigned one for its role (label role:<role>; else a title starting
#             "Design" is the designer's, the rest the engineer's). fleet-judge brief-ready checks the card first; a thin
#             one goes to the architect. At FLEET_PR_CAP open PRs engineers get no new card.
#   asking    a peer whose reply ends in a question: fleet-judge route points the architect, pr-architect or
#             security-architect at it (fleet peek <peer>; the question itself is never relayed); "owner" tells the asker it is its own call; "user" or no confident answer escalates.
#   merged    a PR merged in the last day: its cards (a reference to #<n> or /pull/<n>) go Done; the peer on its branch is
#             told to remove the worktree.
#   red       an open PR with a failing check: its peer gets the failing checks, once per head commit.
#   green     a non-draft PR with every check passed and review required: the pr-architect is told, once per head commit.
#   decision  a proposed decision older than a day escalates.
#   gone      a peer in the roster with no running session escalates.
#   clear     with --live, fleet-clear runs in the background (tokens over FLEET_CLEAR_LIMIT).
# Escalation: a line in $FLEET_STATE/escalations.log, and fleet-send to FLEET_DISPATCH_ESCALATE when that names a peer.
# Settings (environment > profile > default): FLEET_DISPATCH_ROLES ("engineer designer"), FLEET_PR_CAP (5),
#   FLEET_DISPATCH_ESCALATE (none), FLEET_GH_USER (gh account for the target repo; default gh's active one), FLEET_JUDGE*.
# Touches: with --live, the board (card status and assignee), peers' prompts (fleet-send), escalations.log; always
# dispatch.log and the marker folder.
set -uo pipefail
dir=$(cd -P "$(dirname "$0")" && pwd)
source "$dir/lib/tmux.sh"
source "$dir/lib/pane.sh"
source "$dir/lib/profile.sh"
source "$dir/lib/backlog.sh"
source "$dir/lib/worktree.sh"
live=0; [ "${1:-}" = --live ] && live=1
fleet_resolve_repo || exit 1
STATE=$(fleet_state_dir); export BACKLOG_CWD=$STATE
mkdir -p "$STATE"
fleet_lock "$STATE" dispatch 0 2>/dev/null || { echo "fleet-dispatch: a tick is already running"; exit 0; }
MARK=$STATE/dispatch; [ $live = 1 ] || MARK=$STATE/dispatch-dry; mkdir -p "$MARK"
LOG=$STATE/dispatch.log
ROLES=" ${FLEET_DISPATCH_ROLES:-engineer designer} "
CAP=${FLEET_PR_CAP:-5}
SEND=$dir/fleet-send; JUDGE=$dir/fleet-judge; BL=$(fleet_backlog)
if [ -n "${FLEET_GH_USER:-}" ]; then GH_TOKEN=$(gh auth token -u "$FLEET_GH_USER" 2>/dev/null); export GH_TOKEN; fi
now=$(date +%s)

log() { echo "$(date +%FT%T) $1" | tee -a "$LOG"; }
# once <key>: true the first time a key is seen, then false (the marker stays)
once() { local k; k=$(tr -c 'A-Za-z0-9._-' _ <<<"$1"); [ ! -e "$MARK/$k" ] && : > "$MARK/$k"; }
# act "<what>" <command…>: dry run logs it; live runs it and logs the outcome
act() {
  local what=$1; shift
  if [ $live = 0 ]; then log "would: $what"; return 0; fi
  if "$@" >/dev/null 2>&1; then log "did: $what"; else log "FAILED: $what"; return 1; fi
}
send() { act "send $1: ${2:0:140}" "$SEND" "$2" "$1"; }
escalate() {
  log "escalate: $1"
  [ $live = 1 ] || return 0
  echo "$(date +%FT%T) $1" >> "$STATE/escalations.log"
  [ -z "${FLEET_DISPATCH_ESCALATE:-}" ] || "$SEND" "fleet-dispatch needs a call: $1" "$FLEET_DISPATCH_ESCALATE" >/dev/null 2>&1
}
iso_age() { echo $(( now - $(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || date -u -d "$1" +%s) )); }

# ---- state: peers, their branches, the board, the PRs
declare -A role state owner_of
peers=$(fleet_peers | sort)
for p in $peers; do
  role[$p]=$(fleet_peer_role "$p")
  state[$p]=$(fleet_pane_state "$(fleet_pane "$p")")
  cwd=$(tmux display -p -t "$(fleet_peer_target "$p")" '#{pane_current_path}' 2>/dev/null) || cwd=
  b=$([ -n "$cwd" ] && git -C "$cwd" branch --show-current 2>/dev/null)
  [ -z "$b" ] || owner_of[$b]=$p
done
# pr_owner <number> <branch>: the peer on that branch, else the peer recorded on its worktree, else the running peer assigned
# the open card that names the PR
pr_owner() {
  local p w
  p=${owner_of[$2]:-}
  if [ -z "$p" ]; then
    w=$(git -C "$REPO" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$2" '/^worktree /{w=substr($0,10)} $0=="branch " b {print w; exit}')
    [ -z "$w" ] || p=$(fleet_worktree_owner "$w")
  fi
  [ -n "$p" ] || p=$(jq -r --arg n "$1" '[.tasks[] | select(.status != "Done" and ((.references // []) | map(tostring)
      | any(test("(#|/pull/)" + $n + "([^0-9]|$)")))) | (.assignees // [])[] | ltrimstr("@")] | unique[]' <<<"$tasks" | head -1)
  [[ " $(tr '\n' ' ' <<<"$peers") " == *" $p "* ]] && echo "$p"
}
peer_with_role() { local p; for p in $peers; do [ "${role[$p]}" = "$1" ] && { echo "$p"; return; }; done; }

tasks='{"tasks":[]}'; decisions='{"decisions":[]}'
if [ -n "$BL" ] && [ -f "$STATE/backlog/config.yml" ]; then
  tasks=$("$BL" task list --json 2>/dev/null) || tasks='{"tasks":[]}'
  decisions=$("$BL" decision list --json 2>/dev/null) || decisions='{"decisions":[]}'
fi
# PRs from forks are left out: their branch names and check names are not the fleet's, and nothing of theirs reaches a peer
open=$(cd "$REPO" && gh pr list --state open --limit 100 \
  --json number,title,headRefName,headRefOid,isDraft,reviewDecision,statusCheckRollup,isCrossRepository 2>/dev/null) || open='[]'
merged=$(cd "$REPO" && gh pr list --state merged --limit 30 --json number,headRefName,mergedAt,isCrossRepository 2>/dev/null) || merged='[]'
open=$(jq '[.[] | select(.isCrossRepository | not)]' <<<"$open"); merged=$(jq '[.[] | select(.isCrossRepository | not)]' <<<"$merged")
open_count=$(jq length <<<"$open")

# ---- merged
while IFS=$'\t' read -r n br at; do
  [ -n "$n" ] && [ "$(iso_age "$at")" -lt 86400 ] || continue
  # a card that names only this PR is done; one that names several PRs is left to its owner
  while IFS=$'\t' read -r id prs; do
    if [ "$prs" = 1 ]; then once "done-$id-$n" && act "$id Done (#$n merged)" "$BL" task edit "$id" -s Done
    else once "multi-$id-$n" && log "skip: $id names $prs PRs; #$n merged, its owner moves the card"; fi
  done < <(jq -r --arg n "$n" '.tasks[] | select(.status != "Done") | ((.references // []) | map(tostring)) as $r
      | select($r | any(test("(#|/pull/)" + $n + "([^0-9]|$)")))
      | [.id, ([$r[] | scan("(?:#|/pull/)([0-9]+)") | .[0]] | unique | length)] | @tsv' <<<"$tasks")
  p=$(pr_owner "$n" "$br")
  [ -n "$p" ] && once "merged-$n" && send "$p" "#$n is merged. Remove its worktree and branch (fleet wt prune --yes), then report \"worktree gone\"."
done < <(jq -r '.[] | [.number, .headRefName, .mergedAt] | @tsv' <<<"$merged")

# ---- red and green PRs
while IFS=$'\t' read -r n br sha draft review verdict failing; do
  [ -n "$n" ] || continue
  p=$(pr_owner "$n" "$br")
  case "$verdict" in
    red) once "red-$n-$sha" || continue
      if [ -n "$p" ]; then send "$p" "#$n is red at ${sha:0:9}: $failing. Fix it on the branch and push."
      else escalate "#$n is red ($failing) and no running peer owns $br"; fi ;;
    green) [ "$draft" = false ] && [ "$review" = REVIEW_REQUIRED ] || continue
      pa=$(peer_with_role pr-architect)
      [ -n "$pa" ] && once "green-$n-$sha" && send "$pa" "#$n is green at ${sha:0:9} and waits for your review and merge." ;;
  esac
done < <(jq -r '.[] | (.statusCheckRollup // []) as $c
  | ([$c[] | select(((.conclusion // "") | test("FAILURE|CANCELLED|TIMED_OUT|ACTION_REQUIRED|STARTUP_FAILURE"))
      or ((.state // "") | test("FAILURE|ERROR"))) | (.name // .context)]) as $bad
  | ([$c[] | select((.status? and .status != "COMPLETED") or .state == "PENDING")] | length) as $pending
  | [.number, .headRefName, .headRefOid, .isDraft, (.reviewDecision // ""),
     (if ($bad | length) > 0 then "red" elif $pending > 0 or ($c | length) == 0 then "pending" else "green" end),
     ($bad | unique | join(", ") | gsub("[^A-Za-z0-9 _./(),:-]"; "") | .[0:200])] | @tsv' <<<"$open")   # check names go into a prompt

# ---- asking
for p in $peers; do
  [ "${state[$p]}" = asking ] && [ "${role[$p]}" != project-manager ] || continue
  text=$(fleet_pane "$p" | fleet_pane_reply | tail -30)
  once "ask-$p-$(tail -5 <<<"$text" | cksum | cut -d' ' -f1)" || continue
  verdict=$(printf '%s\n' "$text" | "$JUDGE" route) || { escalate "$p asks and fleet-judge cannot route it: $(tail -1 <<<"$text")"; continue; }
  to=${verdict% *}
  case "$to" in
    owner) send "$p" "Your call: you own this work. Decide, note it on your card, and carry on." ;;
    user) escalate "$p asks a question only the user can answer: $(tail -1 <<<"$text")" ;;
    *) t=$(peer_with_role "$to")
      # a pointer, never the question itself: a peer's words are not typed into another peer's prompt
      if [ -n "$t" ] && [ "$t" != "$p" ]; then send "$t" "$p has a question for you. Read it with: fleet peek $p. Answer it with: fleet send \"<answer>\" $p"
      else escalate "$p asks a question for the $to, and no $to peer runs: $(tail -1 <<<"$text")"; fi ;;
  esac
done

# ---- assign
taken=" "
fits() {  # fits <role> <title> <labels csv>
  case ",$3," in *,role:*) [[ ",$3," == *",role:$1,"* ]]; return ;; esac
  case "$2" in [Dd]esign*) [ "$1" = designer ] ;; *) [ "$1" = engineer ] ;; esac
}
brief_ready() {  # brief_ready <id> <updatedAt>: 0 yes, 1 no (sent to the architect), 2 unsure (escalated); cached per card version
  local id=$1 c v ac
  c="$MARK/brief-$1-$(cksum <<<"$2" | cut -d' ' -f1)"
  if [ ! -f "$c" ]; then
    ac=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .acceptanceCriteriaCount // 0' <<<"$tasks")
    v=$({ echo "acceptance criteria: $ac"; "$BL" task view "$id" --plain 2>/dev/null; } | "$JUDGE" brief-ready) || v=unsure
    echo "${v%% *}" > "$c"
  fi
  case "$(cat "$c")" in
    yes) return 0 ;;
    no) a=$(peer_with_role architect)
      if once "thin-$id"; then
        if [ -n "$a" ]; then send "$a" "$id is next in line but its brief is too thin to build from. Complete it (goal, acceptance criteria, where in the code), then reply done."
        else escalate "$id is next in line but its brief is too thin, and no architect runs"; fi
      fi; return 1 ;;
    *) once "unsure-$id" && escalate "fleet-judge cannot tell whether $id is ready to build"; return 2 ;;
  esac
}
for p in $peers; do
  r=${role[$p]}
  [ "${state[$p]}" = idle ] && [[ "$ROLES" == *" $r "* ]] || continue
  holds=$(jq -r --arg a "@$p" '[.tasks[] | select(.status == "In Progress" and ((.assignees // []) | index($a)))] | length' <<<"$tasks")
  [ "$holds" = 0 ] || continue
  if [ "$r" = engineer ] && [ "$open_count" -ge "$CAP" ]; then
    once "cap-$p-$open_count-$(date +%F)" && log "hold: $p is idle, $open_count/$CAP PRs open"; continue
  fi
  while IFS=$'\t' read -r id title labels mine updated; do
    [[ "$taken" == *" $id "* ]] && continue
    [ "$mine" = true ] || fits "$r" "$title" "$labels" || continue
    brief_ready "$id" "$updated" || continue
    taken+="$id "
    once "assign-$p-$id-$(date +%F)" || break   # a dry run moves nothing, so the same pick comes back each tick
    act "$id In Progress @$p" "$BL" task edit "$id" -s "In Progress" -a "@$p" || break
    send "$p" "Your next card: $id $title. Read it with: backlog task view $id --plain. Move it as you work, and report the PR number when it opens."
    break
  done < <(jq -r --arg a "@$p" '[.tasks[] | select(.status == "Next" and (.archived | not)
      and (((.assignees // []) | length) == 0 or ((.assignees // []) | index($a))))]
    | sort_by(((.assignees // []) | index($a) == null), (.ordinal // 1e9), (.id | ltrimstr("TASK-") | split(".") | map(tonumber? // 0)))[]
    | [.id, .title, ((.labels // []) | join(",")), (((.assignees // []) | index($a)) != null), (.updatedAt // .createdAt // "")] | @tsv' <<<"$tasks")
done

# ---- decisions waiting, peers gone, tokens
while IFS=$'\t' read -r id title at; do
  [ -n "$id" ] && [ "$(iso_age "$at")" -gt 86400 ] && once "decision-$id" && escalate "$id has waited over a day for the user: $title"
done < <(jq -r '.decisions[] | select(.status == "proposed") | [.id, .title, .date] | @tsv' <<<"$decisions")
for f in "$STATE"/roster.d/*; do
  [ -f "$f" ] || continue; p=$(basename "$f")
  [[ " $(tr '\n' ' ' <<<"$peers") " == *" $p "* ]] || { once "gone-$p-$(date +%F)" && escalate "$p is in the roster but has no running session"; }
done
clear=$dir/../../fleet-clear/scripts/fleet-clear
[ $live = 1 ] && [ -x "$clear" ] && { nohup "$clear" >> "$STATE/fleet-clear.log" 2>&1 & }
exit 0
