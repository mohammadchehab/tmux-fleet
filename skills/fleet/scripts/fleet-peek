#!/usr/bin/env bash
# fleet-peek: what each peer last said, without its CLI's chrome, for Claude Code and Cursor peers alike.
#   fleet-peek [-n lines] [peer ...]   default: 15 lines, every peer of this fleet (project-manager last, it is you)
# Header per peer: ===== <peer> (<cli>, <state>); state is busy, asking (its reply ends with a question), held or idle.
# Read-only: it types nothing into any pane. The overview of every peer in one line each is fleet-capacity.
set -uo pipefail
source "$(dirname "$0")/lib/tmux.sh"
source "$(dirname "$0")/lib/pane.sh"
n=15
[ "${1:-}" = -n ] && { n=${2:?usage: fleet-peek [-n lines] [peer ...]}; shift 2; }
peers=("$@")
[ ${#peers[@]} -gt 0 ] || peers=($(fleet_peers | sort | awk '$0=="project-manager"{pm=1;next}{print}END{if(pm)print "project-manager"}'))
[ ${#peers[@]} -gt 0 ] || { echo "no $FLEET_SESSION-* sessions running (fleet is down)"; exit 0; }
for p in "${peers[@]}"; do
  pane=$(fleet_pane "$p") || pane=""
  [ -n "$pane" ] || { echo "===== $p (no session $(fleet_session "$p"))"; continue; }
  echo "===== $p ($(fleet_pane_cli "$p" "$pane"), $(fleet_pane_state "$pane"))"
  fleet_pane "$p" 200 | fleet_pane_clean | tail -n "$n"
done
