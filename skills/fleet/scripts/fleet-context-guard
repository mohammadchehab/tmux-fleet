#!/usr/bin/env bash
# fleet-context-guard: Claude Code Stop and PreCompact hook on every fleet peer (skills/fleet/hooks/peer-settings.json, passed
# by fleet-up as --settings). It keeps a peer from ever reaching autocompact: at the end of a turn, a peer whose context is over
# FLEET_CLEAR_LIMIT (environment > profile > 150000 tokens) writes its state and clears itself, so no PM, loop or cron has to.
#   Stop        over the limit, no fresh state file: block the stop, telling the peer to write its state (the project-manager
#               its handoff); with a fresh state file: start fleet-handoff detached (it waits for idle, then /clear, /fleet <role>,
#               "read your state file"). A second stop in the same turn (stop_hook_active) never blocks: a miss is logged.
#   PreCompact  (matcher auto) only appends "<time> <peer> autocompacted" to $FLEET_STATE/compactions.log, so misses show up.
# Reads the hook's JSON on stdin. Outside a fleet-<profile>-<peer> tmux session it does nothing. Never fails the peer: every
# error exits 0 silently. Touches: $FLEET_STATE/context-guard.log and compactions.log (appends); starts fleet-handoff.
# FLEET_HANDOFF_BIN overrides the fleet-handoff script (tests).
set -uo pipefail
dir=$(cd -P "$(dirname "$0")" && pwd)
source "$dir/lib/tmux.sh" || exit 0
source "$dir/lib/profile.sh" || exit 0
fleet_load_profile 2>/dev/null || true   # no profile file: the defaults still apply
own=$(fleet_own_session 2>/dev/null) || exit 0
case "$own" in "$FLEET_SESSION"-board|"$FLEET_SESSION"-) exit 0 ;; "$FLEET_SESSION"-?*) ;; *) exit 0 ;; esac
peer=${own#"$FLEET_SESSION"-}
S=$(fleet_state_dir)
[ -d "$S" ] || exit 0

if [ "${1:-}" = --compacted ]; then
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $peer autocompacted" >> "$S/compactions.log"
  exit 0
fi

role=$(fleet_peer_role "$peer")
if [ "$role" = project-manager ]; then state="$S/handoff.md"; else state="$S/$peer-state.md"; fi
exec python3 "$dir/lib/context-guard.py" "$peer" "$state" "$S" "${FLEET_CLEAR_LIMIT:-150000}" \
  "${FLEET_HANDOFF_BIN:-$dir/../../fleet-handoff/scripts/fleet-handoff}"
