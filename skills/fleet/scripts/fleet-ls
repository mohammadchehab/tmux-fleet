#!/usr/bin/env bash
# fleet-ls: every fleet on this tmux server, grouped by profile: its view session, its board (URL, running or stopped), and each
# peer with its role, CLI and state (busy, idle, asking, held, unknown; lib/pane.sh). Read-only: no lock, nothing typed.
#   fleet-ls            every fleet; with FLEET_PROFILE set, that fleet only
# A peer is a session fleet-up tagged @fleet-role whose name is fleet[-<profile>]-<peer> for its @fleet-profile tag. The view
# (fleet[-<profile>]) and the board (fleet[-<profile>]-board) carry no role and are shown as such; any other session is skipped.
set -uo pipefail
source "$(dirname "$0")/lib/tmux.sh"
source "$(dirname "$0")/lib/pane.sh"
source "$(dirname "$0")/lib/profile.sh"
source "$(dirname "$0")/lib/backlog.sh"
source "$(dirname "$0")/lib/worktree.sh"
only=${FLEET_PROFILE-__all__}
rows=$(tmux ls -F '#{session_name}|#{@fleet-profile}|#{@fleet-role}|#{@fleet-cli}' 2>/dev/null || true)
# the profiles that have a fleet session: a tagged peer, or a view or board session carrying the tag
profiles=$(while IFS='|' read -r s tag role _; do
  [ -n "$s" ] || continue; base=fleet${tag:+-$tag}
  if [ -n "$role" ] && [[ "$s" == "$base"-?* ]]; then echo "=$tag"
  elif [ "$s" = "$base" ] || [ "$s" = "$base-board" ]; then echo "=$tag"; fi
done <<<"$rows" | sort -u)
[ "$only" = __all__ ] || profiles="=$only"
[ -n "$profiles" ] || { echo "no fleet is running on this tmux server${FLEET_TMUX:+ (-L $FLEET_TMUX)}"; exit 0; }
while IFS= read -r p; do
  p=${p#=}
  (
    export FLEET_PROFILE=$p; [ -n "$p" ] || unset FLEET_PROFILE
    fleet_load_profile >/dev/null 2>&1 || true            # the profile's FLEET_BOARD_PORT, if it sets one
    # shellcheck disable=SC2034  # FLEET_SESSION_PROFILE is read by lib/backlog.sh (fleet_board_port)
    FLEET_SESSION_PROFILE=$p; FLEET_SESSION=fleet${p:+-$p}
    v=gone; tmux has-session -t "$(fleet_target "$FLEET_SESSION")" 2>/dev/null && v=running
    b=stopped; tmux has-session -t "$(fleet_target "$(fleet_board_session)")" 2>/dev/null && b=running
    echo "fleet ${p:-(no profile)}   view $FLEET_SESSION: $v   board $(fleet_board_url): $b"
    echo "  $("$(dirname "$0")/fleet-worktree" summary --cached 2>/dev/null | head -1)"
    peers=$(while IFS='|' read -r s tag role cli; do
      [ "$tag" = "$p" ] && [ -n "$role" ] && [[ "$s" == "$FLEET_SESSION"-?* ]] && [ "$s" != "$(fleet_board_session)" ] \
        && echo "${s#"$FLEET_SESSION"-}|$role|$cli"
    done <<<"$rows" | sort)
    if [ -z "$peers" ]; then echo "  no peers"; else
      printf '  %-22s %-20s %-7s %s\n' PEER ROLE CLI STATE
      while IFS='|' read -r peer role cli; do
        pane=$(fleet_pane "$peer"); printf '  %-22s %-20s %-7s %s\n' "$peer" "$role" "${cli:-?}" "$(fleet_pane_state "$pane")"
      done <<<"$peers"
    fi
    echo
  )
done <<<"$profiles"
