#!/usr/bin/env bash
# fleet-clear-heavy: clear idle fleet peers whose "/clear to save Nk tokens" hint is at or above a threshold,
# then reload their role.
#   fleet-clear-heavy [-n] [threshold_k] [peer ...]   default threshold 100 (k tokens), default peers: every peer of this fleet
#   -n  dry run: report only
# Busy peers are never cleared (their in-flight work would be lost).
set -uo pipefail
source "$(dirname "$0")/lib/tmux.sh"
source "$(dirname "$0")/lib/pane.sh"
dir=$(cd "$(dirname "$0")" && pwd)
dry=0; [ "${1:-}" = -n ] && { dry=1; shift; }
threshold=100; [[ "${1:-}" =~ ^[0-9]+$ ]] && { threshold=$1; shift; }
peers=("$@")
[ ${#peers[@]} -gt 0 ] || peers=($(fleet_peers))
for p in "${peers[@]}"; do
  pane=$(tmux capture-pane -p -t "$(fleet_peer_target "$p")" -S -20 2>/dev/null) || { echo "$p: no session"; continue; }
  k=$(grep -o 'clear to save [0-9.]*k tokens' <<<"$pane" | tail -1 | grep -o '[0-9.]*k' | tr -d k)
  if [ "$(fleet_pane_state "$(fleet_pane "$p")")" = busy ]; then echo "$p: busy${k:+ (${k}k)}, skipped"; continue; fi
  if [ -z "$k" ]; then echo "$p: no hint, skipped"; continue; fi
  if awk -v k="$k" -v t="$threshold" 'BEGIN{exit !(k < t)}'; then echo "$p: ${k}k < ${threshold}k, kept"; continue; fi
  role=$(fleet_peer_role "$p")
  if [ $dry = 1 ]; then echo "$p: ${k}k, would clear and reload /fleet $role"; continue; fi
  echo "$p: ${k}k, clearing"
  "$dir/fleet-send" /clear "$p" >/dev/null
  "$dir/fleet-send" "/fleet $role" "$p" >/dev/null
done
