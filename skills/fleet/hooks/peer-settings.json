{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/fleet/scripts/fleet-session-record",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/fleet/scripts/fleet-reply-log",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/skills/fleet/scripts/fleet-session-record",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/skills/fleet/scripts/fleet-context-guard",
            "timeout": 40
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/fleet/scripts/fleet-context-guard --compacted",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
