#!/usr/bin/env bash
# board-jira: put Jira issues on this fleet's board (Backlog.md in $FLEET_STATE/backlog), idempotently. Never creates a duplicate:
# a card belongs to an issue by its title prefix "[<KEY>-<n>] ", and a second run with the same input changes nothing.
#   board-jira < issues.json
# Input: a JSON array, one object per issue, as the fleet-board skill builds it from the Atlassian MCP's search:
#   {"key": "<KEY>-<n>", "summary": "...", "status": "<Jira status name>", "statusCategory": "new|indeterminate|done",
#    "epic": "<epic key> <epic name>" or null, "url": "https://<site>/browse/<KEY>-<n>"}
# Per issue: the epic becomes a milestone (added once); a new issue becomes a card with the label jira, the issue URL as a
# reference and the mapped column; a known one gets its title, milestone and reference refreshed. Its column follows Jira only
# while the card is still in Backlog or Next, or when Jira says done: a card a peer has moved is the peer's, not Jira's.
# Column map: done -> Done; indeterminate -> Review when the status name says review/QA/test, else In Progress;
# new -> Next when the status name says selected/ready/next, else Backlog.
# Prints one line per issue (created / updated / unchanged) and a total. Touches only the board's files, through the backlog CLI.
set -euo pipefail
source "$(dirname "$0")/../../fleet/scripts/lib/tmux.sh"
source "$(dirname "$0")/../../fleet/scripts/lib/profile.sh"
source "$(dirname "$0")/../../fleet/scripts/lib/backlog.sh"
fleet_load_profile || exit 1
STATE=$(fleet_state_dir); export BACKLOG_CWD=$STATE
fleet_backlog_check || exit 1
fleet_lock "$STATE" board || exit 1   # one board script at a time (lib/lock.sh; lib/backlog.sh sources it)
BL=$(fleet_backlog)
[ -f "$STATE/backlog/config.yml" ] || fleet_backlog_init "$STATE" || { echo "board-jira: no board in $STATE/backlog" >&2; exit 1; }
issues=$(cat)
jq -e 'type == "array"' <<<"$issues" >/dev/null || { echo "board-jira: stdin is not a JSON array of issues" >&2; exit 2; }
column() {  # <statusCategory> <status name> -> board column
  local cat n; cat=$(tr '[:upper:]' '[:lower:]' <<<"$1"); n=$(tr '[:upper:]' '[:lower:]' <<<"$2")
  case "$cat" in
    done) echo Done ;;
    indeterminate|"in progress") case "$n" in *review*|*qa*|*test*) echo Review ;; *) echo "In Progress" ;; esac ;;
    *) case "$n" in *selected*|*ready*|*next*) echo Next ;; *) echo Backlog ;; esac ;;
  esac
}
cards=$("$BL" task list --json)
created=0; updated=0; same=0
while IFS= read -r it; do
  key=$(jq -r .key <<<"$it"); [[ "$key" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]] || { echo "skip: bad key '$key'" >&2; continue; } # lint: allow the key pattern, not a key
  title="[$key] $(jq -r '.summary // ""' <<<"$it" | tr '\n' ' ')"; title=${title% }
  col=$(column "$(jq -r '.statusCategory // ""' <<<"$it")" "$(jq -r '.status // ""' <<<"$it")")
  epic=$(jq -r '.epic // empty' <<<"$it"); url=$(jq -r '.url // empty' <<<"$it")
  if [ -n "$epic" ]; then
    out=$("$BL" milestone add "$epic" 2>&1) || grep -q 'alias conflict' <<<"$out" || { echo "board-jira: milestone '$epic': $out" >&2; exit 1; }
  fi
  card=$(jq -c --arg p "[$key] " '[.tasks[] | select(.title | startswith($p))] | first // empty' <<<"$cards")
  if [ -z "$card" ]; then
    args=(task create "$title" -s "$col" -l jira --plain)
    [ -z "$epic" ] || args+=(-m "$epic"); [ -z "$url" ] || args+=(--ref "$url")
    "$BL" "${args[@]}" >/dev/null; created=$((created + 1)); echo "created  $key -> $col"
    continue
  fi
  id=$(jq -r .id <<<"$card"); now=$(jq -r .status <<<"$card"); args=()
  [ "$(jq -r .title <<<"$card")" = "$title" ] || args+=(-t "$title")
  case "$now" in Backlog|Next) [ "$now" = "$col" ] || args+=(-s "$col") ;; *) [ "$col" != Done ] || [ "$now" = Done ] || args+=(-s Done) ;; esac
  if [ -n "$epic" ]; then
    ms=$("$BL" milestone list --plain | sed -n 's/^ *\(m-[0-9]*\): \(.*\) ([0-9]*\/[0-9]* done)$/\1|\2/p' | awk -F'|' -v e="$epic" '$2 == e {print $1; exit}')
    [ -n "$ms" ] && [ "$(jq -r '.milestone // ""' <<<"$card")" = "$ms" ] || args+=(-m "$epic")
  fi
  if [ ${#args[@]} -eq 0 ]; then same=$((same + 1)); echo "same     $key ($now)"; continue; fi
  "$BL" task edit "$id" "${args[@]}" --plain >/dev/null; updated=$((updated + 1)); echo "updated  $key $id: ${args[*]}"
done < <(jq -c '.[]' <<<"$issues")
echo "board-jira: $created created, $updated updated, $same unchanged ($(fleet_board_url))"
