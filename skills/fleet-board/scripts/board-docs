#!/usr/bin/env bash
# board-docs: copy the target repo's spec and architecture markdown onto this fleet's board, so its Docs view shows them.
#   board-docs [path …]   files or folders in the target repo (relative to it, or absolute); folders give their *.md files
# Which files: the arguments; else FLEET_BOARD_DOCS (a profile key: space-separated paths in the target repo); else every
# tracked .md that is named ARCHITECTURE*/SPEC* or sits in a folder named architecture, arch, spec(s), adr(s), decisions or design.
# Each file becomes $FLEET_STATE/backlog/docs/repo/<its path in the repo> with Backlog.md's frontmatter
# (id doc-repo-<path slug>, title = its path, type specification) over the file's own text (its own frontmatter dropped).
# The repo is the source: every run brings docs/repo/ in line with it, file by file in place (so the running board page sees
# each change), and removes copies whose file is gone. Docs the fleet writes
# itself (elsewhere under docs/) are never touched. The target repo is only read.
set -euo pipefail
source "$(dirname "$0")/../../fleet/scripts/lib/tmux.sh"
source "$(dirname "$0")/../../fleet/scripts/lib/profile.sh"
source "$(dirname "$0")/../../fleet/scripts/lib/backlog.sh"
fleet_resolve_repo || exit 1
STATE=$(fleet_state_dir); OUT="$STATE/backlog/docs/repo"
fleet_lock "$STATE" board || exit 1   # one board script at a time (lib/lock.sh; lib/backlog.sh sources it)
[ -f "$STATE/backlog/config.yml" ] || fleet_backlog_init "$STATE" || { echo "board-docs: no board in $STATE/backlog (task install:backlog)" >&2; exit 1; }
if [ $# -eq 0 ] && [ -n "${FLEET_BOARD_DOCS:-}" ]; then read -r -a _docs <<<"$FLEET_BOARD_DOCS"; set -- "${_docs[@]}"; fi
files=()
if [ $# -gt 0 ]; then
  for p in "$@"; do
    case "$p" in /*) ;; *) p="$REPO/$p" ;; esac
    if [ -d "$p" ]; then while IFS= read -r f; do files+=("$f"); done < <(find "$p" -name '*.md' -type f | sort)
    elif [ -f "$p" ]; then files+=("$p")
    else echo "board-docs: no such file or folder: $p" >&2; exit 1; fi
  done
else
  while IFS= read -r f; do files+=("$REPO/$f"); done < <(git -C "$REPO" ls-files '*.md' \
    | grep -iE '(^|/)(architecture|arch|specs?|adrs?|decisions|design)/|(^|/)(architecture|spec)[^/]*\.md$' || true)
fi
tmp=$(mktemp -d)
for f in ${files[@]+"${files[@]}"}; do
  rel=${f#"$REPO"/}; [ "$rel" != "$f" ] || rel=$(basename "$f")
  slug=$(tr '[:upper:]' '[:lower:]' <<<"${rel%.md}" | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')
  mkdir -p "$tmp/$(dirname "$rel")"
  { printf -- '---\nid: doc-repo-%s\ntitle: "%s"\ntype: specification\n---\n\n' "$slug" "${rel//\"/\'}"
    awk 'NR==1 && $0=="---" {fm=1; next} fm && $0=="---" {fm=0; next} !fm' "$f"; } > "$tmp/$rel"
done
# update docs/repo in place, file by file: the running board page watches these files, and a folder that is removed and
# moved back in under the same name is lost to its watcher (the page then shows no documents until it restarts)
mkdir -p "$OUT"
(cd "$tmp" && find . -type f) | while IFS= read -r f; do
  cmp -s "$tmp/$f" "$OUT/$f" || { mkdir -p "$(dirname "$OUT/$f")"; cat "$tmp/$f" > "$OUT/$f"; }
done
(cd "$OUT" && find . -type f) | while IFS= read -r f; do [ -e "$tmp/$f" ] || rm -f "$OUT/$f"; done
find "$OUT" -mindepth 1 -type d -empty -delete
rm -rf "$tmp"
echo "board-docs: ${#files[@]} files from $REPO in $OUT ($(fleet_board_url))"
