#!/usr/bin/env bash
# cc-send: type a command into running Claude Code sessions in iTerm2, keyed by the session's TTY.
#   cc-send                         list sessions: pid, tty, iTerm2 tab name
#   cc-send <match> "<text>"        type <text> + Enter into the session whose pid, tty or tab name contains <match>
#   cc-send --all "<text>"          the same into every Claude session
# Examples: cc-send architect /clear      cc-send --all /compact
# Live sessions come from the peer sockets /tmp/cc-socks/<pid>.sock (dead pids are skipped). A session in a tmux
# pane is typed into with tmux send-keys (name = the pane's window title or "tmux <target>"); otherwise iTerm2.
set -euo pipefail

sessions() {  # pid tty name
  for s in /tmp/cc-socks/*.sock; do
    pid=$(basename "$s" .sock)
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ') || true
    [ -n "$tty" ] || continue
    pane=$(tmux list-panes -a -F '#{pane_tty} #{session_name}:#{window_index}.#{pane_index}' 2>/dev/null | awk -v t="/dev/$tty" '$1==t{print $2}')
    if [ -n "$pane" ]; then
      name=$(tmux capture-pane -p -t "$pane" 2>/dev/null | { grep -oE '─ [A-Za-z0-9._-]+ ─' || true; } | tail -1 | tr -d '─ ')
      printf '%s\t%s\t%s\n' "$pid" "$tty" "${name:-tmux $pane}"; continue
    fi
    name=$(osascript -e "tell application \"iTerm2\"
repeat with w in windows
  repeat with t in tabs of w
    repeat with s in sessions of t
      if tty of s is \"/dev/$tty\" then return name of s
    end repeat
  end repeat
end repeat
return \"\"
end tell" 2>/dev/null)
    printf '%s\t%s\t%s\n' "$pid" "$tty" "$name"
  done
}

send() {  # tty text (raw)
  pane=$(tmux list-panes -a -F '#{pane_tty} #{session_name}:#{window_index}.#{pane_index}' 2>/dev/null | awk -v t="/dev/$1" '$1==t{print $2}')
  if [ -n "$pane" ]; then tmux send-keys -t "$pane" -l "$2"; sleep 0.6; tmux send-keys -t "$pane" Enter; echo "ok (tmux $pane)"; return; fi
  osascript -e "tell application \"iTerm2\"
repeat with w in windows
  repeat with t in tabs of w
    repeat with s in sessions of t
      if tty of s is \"/dev/$1\" then
        tell s to write text \"${2//\"/\\\"}\"
        return \"ok\"
      end if
    end repeat
  end repeat
end repeat
return \"no iTerm2 session on /dev/$1\"
end tell"
}

if [ $# -eq 0 ]; then sessions | column -t -s $'\t'; exit 0; fi
[ $# -eq 2 ] || { echo "usage: cc-send [<match>|--all] \"<text>\"" >&2; exit 2; }
match=$1; text=$2
list=$(sessions)
# An exact pid, tty or name match wins over substrings, so "architect" does not also hit pr-architect.
exact=$(awk -F'\t' -v m="$match" '$1==m||$2==m||$3==m' <<<"$list")
hit=0
while IFS=$'\t' read -r pid tty name; do
  [ -n "$pid" ] || continue
  if [ "$match" = --all ] || [ -n "$exact" ] || [[ "$pid $tty $name" == *"$match"* ]]; then
    hit=1; printf '%s (%s): %s\n' "${name:-pid $pid}" "$tty" "$(send "$tty" "$text")"
  fi
done <<<"${exact:-$list}"
[ $hit = 1 ] || { echo "no session matches '$match'" >&2; exit 1; }
